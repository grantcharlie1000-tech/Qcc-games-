{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "QCC_STUDY_SCHEMA_APPROVED=qcc-games-api:production:20261108120000_study_pairing node scripts/apply-whetu-linkage-only.mjs",
  "outputDirectory": "server/public",
  "functions": {
    "api/[route].js": {
      "maxDuration": 10,
      "includeFiles": "dist-server/**"
    }
  },
  "crons": [
    {
      "path": "/api/chat-purge",
      "schedule": "7 3 * * *"
    },
    {
      "path": "/api/predictions-grants",
      "schedule": "17 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.netlify/functions/:route",
      "destination": "/api/:route"
    }
  ]
}
