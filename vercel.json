{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run check:server && npm run build:server && node scripts/migrate-last-light.mjs && node scripts/migrate-movie-progress.mjs",
  "outputDirectory": "server/public",
  "functions": {
    "api/[route].js": {
      "maxDuration": 10,
      "includeFiles": "dist-server/**"
    }
  },
  "crons": [
    {
      "path": "/api/chat-purge",
      "schedule": "7 3 * * *"
    },
    {
      "path": "/api/predictions-grants",
      "schedule": "17 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/.netlify/functions/:route",
      "destination": "/api/:route"
    }
  ]
}
