{
  "name": "pocket-offline-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/movies-validate.mjs && tsc --noEmit && vite build && node scripts/offline-manifest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "dev:online": "node scripts/leaderboard-dev.mjs",
    "movies:import": "node scripts/movies-import.mjs"
  },
  "dependencies": {
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.3",
    "@sparticuz/chromium": "153.0.0",
    "globe.gl": "2.46.2",
    "hls.js": "1.7.3",
    "ipaddr.js": "2.5.0",
    "matter-js": "0.20.0",
    "peerjs": "1.5.5",
    "puppeteer-core": "25.16.0",
    "three": "^0.180.0",
    "three-conic-polygon-geometry": "2.1.3",
    "three-geojson-geometry": "2.1.1"
  },
  "devDependencies": {
    "@netlify/database-dev": "1.0.1",
    "@playwright/test": "^1.56.0",
    "@types/matter-js": "^0.20.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
