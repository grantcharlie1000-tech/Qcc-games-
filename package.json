{
  "name": "pocket-offline-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/movies-validate.mjs && tsc --noEmit && vite build && node scripts/offline-manifest.mjs && node scripts/check-client-db-boundary.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "dev:online": "node scripts/leaderboard-dev.mjs",
    "movies:import": "node scripts/movies-import.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-migrate.mjs --status"
  },
  "dependencies": {
    "@netlify/functions": "6.0.3",
    "globe.gl": "2.46.2",
    "matter-js": "0.20.0",
    "peerjs": "1.5.5",
    "pg": "^8.23.1",
    "three": "^0.180.0",
    "three-conic-polygon-geometry": "2.1.3",
    "three-geojson-geometry": "2.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@playwright/test": "^1.56.0",
    "@types/matter-js": "^0.20.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.180.0",
    "pg-gateway": "^0.3.0-beta.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
