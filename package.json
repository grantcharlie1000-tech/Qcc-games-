{
  "name": "pocket-offline-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/movies-validate.mjs && tsc --noEmit && vite build && node scripts/prepare-whetu-host.mjs && node scripts/verify-sw-kill-switch.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:noindex": "node --test scripts/verify-noindex.mjs",
    "verify:update": "node scripts/verify-update.mjs",
    "dev:online": "node scripts/leaderboard-dev.mjs",
    "movies:import": "node scripts/movies-import.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "@netlify/database": "2.0.1",
    "@netlify/functions": "6.0.3",
    "globe.gl": "2.46.2",
    "matter-js": "0.20.0",
    "peerjs": "1.5.5",
    "sharp": "0.35.5",
    "three": "^0.180.0",
    "three-conic-polygon-geometry": "2.1.3",
    "three-geojson-geometry": "2.1.1"
  },
  "devDependencies": {
    "@netlify/database-dev": "1.0.1",
    "@playwright/test": "^1.56.0",
    "@types/matter-js": "^0.20.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "happy-dom": "21.0.4",
    "miniflare": "5.20261104.0-beta",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
