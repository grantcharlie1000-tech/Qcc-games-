    "@types/matter-js": "^0.20.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
