{
  "name": "qcc",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.netlify/functions/*", "/api/*"]
  },
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "REPLACE_AFTER_HYPERDRIVE_CREATED"}],
  "vars": {"QCC_DEPLOY_CONTEXT": "production"}
}
