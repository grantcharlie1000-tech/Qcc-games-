{
  "name": "qcc",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/.netlify/functions/*", "/api/*"]
  },
  "hyperdrive": [{"binding": "HYPERDRIVE", "id": "REPLACE_AFTER_HYPERDRIVE_CREATED"}],
  "ratelimits": [
    {"name": "RL_ACCOUNTS", "namespace_id": "1001", "simple": {"limit": 600, "period": 60}},
    {"name": "RL_LEADERBOARD", "namespace_id": "1002", "simple": {"limit": 300, "period": 60}},
    {"name": "RL_TURN", "namespace_id": "1003", "simple": {"limit": 20, "period": 60}}
  ],
  "vars": {"QCC_DEPLOY_CONTEXT": "production"}
}
