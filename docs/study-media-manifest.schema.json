{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public generated Study media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generation",
    "disclosure",
    "assets"
  ],
  "properties": {
    "disclosure": {
      "const": "Contributor portraits depict fictional adults, not real authors or credentialed experts. Article photos are illustrative generated scenes, not documentary evidence of specific people, places, experiments or events."
    },
    "assets": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "width",
          "height",
          "kind"
        ],
        "properties": {
          "path": {
            "enum": [
              "contributors/ari-rowan.webp",
              "contributors/mina-vale.webp",
              "contributors/leo-finch.webp",
              "contributors/nell-moss.webp",
              "photos/reading-writing.webp",
              "photos/film-making.webp",
              "photos/field-measurement.webp",
              "photos/forces-energy.webp",
              "photos/seedlings-ecology.webp",
              "photos/river-catchment.webp",
              "photos/produce-market.webp",
              "photos/community-wellbeing.webp"
            ]
          },
          "mimeType": {
            "const": "image/webp"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "fictional-contributor-portrait",
              "illustrative-photo"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "version": {
      "const": 1
    },
    "generation": {
      "const": "AI-generated with GPT Image; resized and compressed to WebP."
    }
  }
}
